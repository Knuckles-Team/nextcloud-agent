    :usesTool nc:tool_add_participant, nc:tool_create_calendar, nc:tool_create_contact, nc:tool_create_conversation, nc:tool_create_event, nc:tool_create_note, nc:tool_create_task, nc:tool_delete_calendar, nc:tool_delete_calendar_object, nc:tool_delete_contact, nc:tool_delete_conversation, nc:tool_delete_message, nc:tool_delete_note, nc:tool_get_calendar_object, nc:tool_get_contact, nc:tool_get_conversation, nc:tool_get_note, nc:tool_list_address_books, nc:tool_list_calendars, nc:tool_list_contacts, nc:tool_list_conversations, nc:tool_list_events, nc:tool_list_messages, nc:tool_list_notes, nc:tool_list_participants, nc:tool_list_tasks, nc:tool_remove_participant, nc:tool_rename_conversation, nc:tool_send_message, nc:tool_update_contact, nc:tool_update_event, nc:tool_update_note, nc:tool_update_task .

nc:prompt_nextcloud_project_coordinator a cp:Prompt ;
    rdfs:label "Project Coordinator" ;
    cp:componentId "project_coordinator" ;
    cp:appliesTo :DeckCard ;
    :promptUsesSkill nc:skill_nextcloud_deck, nc:skill_nextcloud_tasks, nc:skill_nextcloud_office, nc:skill_nextcloud_notes, nc:skill_nextcloud_activity ;
    :usesTool nc:tool_assign_card_user, nc:tool_create_board, nc:tool_create_card, nc:tool_create_document, nc:tool_create_note, nc:tool_create_stack, nc:tool_create_task, nc:tool_delete_board, nc:tool_delete_card, nc:tool_delete_note, nc:tool_delete_stack, nc:tool_dismiss_notification, nc:tool_get_board, nc:tool_get_card, nc:tool_get_note, nc:tool_list_activities, nc:tool_list_boards, nc:tool_list_document_templates, nc:tool_list_notes, nc:tool_list_notifications, nc:tool_list_stacks, nc:tool_list_tasks, nc:tool_move_card, nc:tool_open_document, nc:tool_update_card, nc:tool_update_note, nc:tool_update_task .

nc:prompt_nextcloud_workspace_admin a cp:Prompt ;
    rdfs:label "Workspace Administrator" ;
    cp:componentId "workspace_admin" ;
    cp:appliesTo :IdentityUser ;
    :promptUsesSkill nc:skill_nextcloud_admin, nc:skill_nextcloud_shares, nc:skill_nextcloud_activity ;
    :usesTool nc:tool_add_user_to_group, nc:tool_create_group, nc:tool_create_share, nc:tool_create_user, nc:tool_delete_group, nc:tool_delete_share, nc:tool_delete_user, nc:tool_disable_app, nc:tool_disable_user, nc:tool_dismiss_notification, nc:tool_enable_app, nc:tool_enable_user, nc:tool_get_app, nc:tool_get_share, nc:tool_get_user, nc:tool_get_user_info, nc:tool_list_activities, nc:tool_list_apps, nc:tool_list_group_members, nc:tool_list_groups, nc:tool_list_notifications, nc:tool_list_shares, nc:tool_list_users, nc:tool_remove_user_from_group, nc:tool_update_share, nc:tool_update_user .

nc:prompt_nextcloud_file_steward a cp:Prompt ;
    rdfs:label "Nextcloud File Steward" ;
    cp:componentId "file_steward" ;
    cp:appliesTo :File ;
    :promptUsesSkill nc:skill_nextcloud_files, nc:skill_nextcloud_shares, nc:skill_nextcloud_ingest ;
    :usesTool nc:tool_copy_item, nc:tool_create_folder, nc:tool_create_share, nc:tool_delete_item, nc:tool_delete_share, nc:tool_get_properties, nc:tool_get_share, nc:tool_get_user_quota, nc:tool_list_files, nc:tool_list_shares, nc:tool_list_trash, nc:tool_list_versions, nc:tool_move_item, nc:tool_read_file, nc:tool_restore_trash_item, nc:tool_restore_version, nc:tool_search_files, nc:tool_update_share, nc:tool_write_file .

# --- tool-use contracts: ordered steps ---

nc:contract_publish_asset a :ToolUseContract ;
    rdfs:label "Publish a produced asset to the team folder and share it" ;
    :hasStep nc:contract_publish_asset_step1, nc:contract_publish_asset_step2, nc:contract_publish_asset_step3, nc:contract_publish_asset_step4, nc:contract_publish_asset_step5, nc:contract_publish_asset_step6, nc:contract_publish_asset_step7 .

nc:contract_publish_asset_step1 a :TaskStep ;
    :stepIndex 1 ;
    :usesTool nc:tool_list_files ;
    :stepParameters "path=ArtCraft/<namespace>/<date>/<run>" ;
    :stepGuidance "locate the asset the craft suite wrote (or search_files by name)" ;
    :needsSkill nc:skill_nextcloud_publish_asset ;
    :precedes nc:contract_publish_asset_step2 .

nc:contract_publish_asset_step2 a :TaskStep ;
    :stepIndex 2 ;
    :usesTool nc:tool_create_folder ;
    :stepParameters "path=Team/<campaign>" ;
    :stepGuidance "make the campaign folder; an exists error is fine" ;
    :needsSkill nc:skill_nextcloud_publish_asset ;
    :precedes nc:contract_publish_asset_step3 .

nc:contract_publish_asset_step3 a :TaskStep ;
    :stepIndex 3 ;
    :usesTool nc:tool_copy_item ;
    :stepParameters "source_path=<asset>, dest_path=Team/<campaign>/<name>" ;
    :stepGuidance "copy, so the produced original stays in the archive" ;
    :needsSkill nc:skill_nextcloud_publish_asset ;
    :precedes nc:contract_publish_asset_step4 .

nc:contract_publish_asset_step4 a :TaskStep ;
    :stepIndex 4 ;
    :usesTool nc:tool_list_shares ;
    :stepParameters "path=Team/<campaign>" ;
    :stepGuidance "check whether the team already has the folder" ;
    :needsSkill nc:skill_nextcloud_publish_asset ;
    :precedes nc:contract_publish_asset_step5 .

nc:contract_publish_asset_step5 a :TaskStep ;
    :stepIndex 5 ;
    :usesTool nc:tool_create_share ;
    :stepParameters "path=Team/<campaign>, share_type=group, share_with=<team group>, permissions=1" ;
    :stepGuidance "grant the team read access once" ;
    :needsSkill nc:skill_nextcloud_publish_asset ;
    :precedes nc:contract_publish_asset_step6 .

nc:contract_publish_asset_step6 a :TaskStep ;
    :stepIndex 6 ;
    :usesTool nc:tool_create_share ;
    :stepParameters "path=Team/<campaign>/<name>, share_type=public_link, expire_date=<YYYY-MM-DD>, label=<campaign>" ;
    :stepGuidance "the public link for external use; read back url" ;
    :needsSkill nc:skill_nextcloud_publish_asset ;
    :precedes nc:contract_publish_asset_step7 .

nc:contract_publish_asset_step7 a :TaskStep ;
    :stepIndex 7 ;
    :usesTool nc:tool_get_share ;
    :stepParameters "share_id=<id>" ;
    :stepGuidance "verify the link and its expiry before reporting" ;
    :needsSkill nc:skill_nextcloud_publish_asset .

nc:contract_schedule_meeting a :ToolUseContract ;
    rdfs:label "Schedule a meeting with draft invitations" ;
    :hasStep nc:contract_schedule_meeting_step1, nc:contract_schedule_meeting_step2, nc:contract_schedule_meeting_step3, nc:contract_schedule_meeting_step4 .

nc:contract_schedule_meeting_step1 a :TaskStep ;
    :stepIndex 1 ;
    :usesTool nc:tool_list_calendars ;
    :stepParameters "" ;
    :stepGuidance "pick the calendar" ;
    :needsSkill nc:skill_nextcloud_calendar ;
    :precedes nc:contract_schedule_meeting_step2 .

nc:contract_schedule_meeting_step2 a :TaskStep ;
    :stepIndex 2 ;
    :usesTool nc:tool_list_events ;
    :stepParameters "calendar_url, start, end" ;
    :stepGuidance "check the slot is free" ;
    :needsSkill nc:skill_nextcloud_calendar ;
    :precedes nc:contract_schedule_meeting_step3 .

nc:contract_schedule_meeting_step3 a :TaskStep ;
    :stepIndex 3 ;
    :usesTool nc:tool_create_event ;
    :stepParameters "calendar_url, summary, start, end, attendees, send_invitations=false" ;
    :stepGuidance "invites stay drafts" ;
    :needsSkill nc:skill_nextcloud_calendar ;
    :precedes nc:contract_schedule_meeting_step4 .

nc:contract_schedule_meeting_step4 a :TaskStep ;
    :stepIndex 4 ;
    :usesTool nc:tool_get_calendar_object ;
    :stepParameters "object_url" ;
    :stepGuidance "verify" ;
    :needsSkill nc:skill_nextcloud_calendar .

nc:contract_team_announcement a :ToolUseContract ;
    rdfs:label "Post an update to a private team conversation" ;
    :hasStep nc:contract_team_announcement_step1, nc:contract_team_announcement_step2, nc:contract_team_announcement_step3 .

nc:contract_team_announcement_step1 a :TaskStep ;
    :stepIndex 1 ;
    :usesTool nc:tool_list_conversations ;
    :stepParameters "" ;
    :stepGuidance "find the team conversation token" ;
    :needsSkill nc:skill_nextcloud_talk ;
    :precedes nc:contract_team_announcement_step2 .

nc:contract_team_announcement_step2 a :TaskStep ;
    :stepIndex 2 ;
    :usesTool nc:tool_send_message ;
    :stepParameters "token, message" ;
    :stepGuidance "internal only, never a public conversation without approval" ;
    :needsSkill nc:skill_nextcloud_talk ;
    :precedes nc:contract_team_announcement_step3 .

nc:contract_team_announcement_step3 a :TaskStep ;
    :stepIndex 3 ;
    :usesTool nc:tool_list_messages ;
    :stepParameters "token, limit=5" ;
    :stepGuidance "verify it posted" ;
    :needsSkill nc:skill_nextcloud_talk .

nc:contract_track_work a :ToolUseContract ;
    rdfs:label "Track a piece of work on a Deck board" ;
    :hasStep nc:contract_track_work_step1, nc:contract_track_work_step2, nc:contract_track_work_step3, nc:contract_track_work_step4 .

nc:contract_track_work_step1 a :TaskStep ;
    :stepIndex 1 ;
    :usesTool nc:tool_list_boards ;
    :stepParameters "" ;
    :stepGuidance "find the board" ;
    :needsSkill nc:skill_nextcloud_deck ;
    :precedes nc:contract_track_work_step2 .

nc:contract_track_work_step2 a :TaskStep ;
    :stepIndex 2 ;
    :usesTool nc:tool_list_stacks ;
    :stepParameters "board_id" ;
    :stepGuidance "find the stack" ;
    :needsSkill nc:skill_nextcloud_deck ;
    :precedes nc:contract_track_work_step3 .

nc:contract_track_work_step3 a :TaskStep ;
    :stepIndex 3 ;
    :usesTool nc:tool_create_card ;
    :stepParameters "board_id, stack_id, title, duedate" ;
    :stepGuidance "add the card" ;
    :needsSkill nc:skill_nextcloud_deck ;
    :precedes nc:contract_track_work_step4 .

nc:contract_track_work_step4 a :TaskStep ;
    :stepIndex 4 ;
    :usesTool nc:tool_move_card ;
    :stepParameters "board_id, card_id, target_stack_id" ;
    :stepGuidance "advance it" ;
    :needsSkill nc:skill_nextcloud_deck .

nc:contract_collaborate_document a :ToolUseContract ;
    rdfs:label "Create a document for the team to edit together" ;
    :hasStep nc:contract_collaborate_document_step1, nc:contract_collaborate_document_step2, nc:contract_collaborate_document_step3 .

nc:contract_collaborate_document_step1 a :TaskStep ;
    :stepIndex 1 ;
    :usesTool nc:tool_create_document ;
    :stepParameters "path=Team/<area>/<name>.docx" ;
    :stepGuidance "the extension picks the type" ;
    :needsSkill nc:skill_nextcloud_office ;
    :precedes nc:contract_collaborate_document_step2 .

nc:contract_collaborate_document_step2 a :TaskStep ;
    :stepIndex 2 ;
    :usesTool nc:tool_create_share ;
    :stepParameters "path, share_type=group, share_with=<team group>, permissions=15" ;
    :stepGuidance "edit rights for the team" ;
    :needsSkill nc:skill_nextcloud_office ;
    :precedes nc:contract_collaborate_document_step3 .

nc:contract_collaborate_document_step3 a :TaskStep ;
    :stepIndex 3 ;
    :usesTool nc:tool_open_document ;
    :stepParameters "path" ;
    :stepGuidance "one-time editor URL for the requester" ;
    :needsSkill nc:skill_nextcloud_office .

nc:contract_onboard_member a :ToolUseContract ;
    rdfs:label "Onboard a team member" ;
    :hasStep nc:contract_onboard_member_step1, nc:contract_onboard_member_step2, nc:contract_onboard_member_step3 .

nc:contract_onboard_member_step1 a :TaskStep ;
    :stepIndex 1 ;
    :usesTool nc:tool_create_user ;
    :stepParameters "user_id, email, display_name, groups=[<team group>]" ;
    :stepGuidance "email invite, no password in chat" ;
    :needsSkill nc:skill_nextcloud_admin ;
    :precedes nc:contract_onboard_member_step2 .

nc:contract_onboard_member_step2 a :TaskStep ;
    :stepIndex 2 ;
    :usesTool nc:tool_get_user ;
    :stepParameters "user_id" ;
    :stepGuidance "verify" ;
    :needsSkill nc:skill_nextcloud_admin ;
    :precedes nc:contract_onboard_member_step3 .

nc:contract_onboard_member_step3 a :TaskStep ;
    :stepIndex 3 ;
    :usesTool nc:tool_add_participant ;
    :stepParameters "token, participant=user_id" ;
    :stepGuidance "add to the team conversation" ;
    :needsSkill nc:skill_nextcloud_admin .

# --- data locations ---

nc:location_files a :NextcloudDataLocation ;
    rdfs:label "Account files" ;
    :locationTemplate "{NEXTCLOUD_URL}/remote.php/dav/files/{user}/" ;
    :accessProtocol "WebDAV" ;
    :holdsClass :File, :Folder, :OfficeDocument ;
    :routedThrough nc:connector ;
    :ingestSource "nextcloud-files" .

nc:location_versions a :NextcloudDataLocation ;
    rdfs:label "File versions" ;
    :locationTemplate "{NEXTCLOUD_URL}/remote.php/dav/versions/{user}/versions/{fileid}/" ;
    :accessProtocol "WebDAV" ;
    :holdsClass :FileVersion ;
    :routedThrough nc:connector .

nc:location_trash a :NextcloudDataLocation ;
    rdfs:label "Trash bin" ;
    :locationTemplate "{NEXTCLOUD_URL}/remote.php/dav/trashbin/{user}/trash/" ;
    :accessProtocol "WebDAV" ;
    :holdsClass :TrashItem ;
    :routedThrough nc:connector .

nc:location_shares a :NextcloudDataLocation ;
    rdfs:label "Share grants" ;
    :locationTemplate "{NEXTCLOUD_URL}/ocs/v2.php/apps/files_sharing/api/v1/shares" ;
    :accessProtocol "OCS" ;
    :holdsClass :Share ;
    :routedThrough nc:connector ;
    :ingestSource "nextcloud-shares" .

nc:location_calendars a :NextcloudDataLocation ;
    rdfs:label "Calendars, events and tasks" ;
    :locationTemplate "{NEXTCLOUD_URL}/remote.php/dav/calendars/{user}/" ;
    :accessProtocol "CalDAV" ;
    :holdsClass :NextcloudCalendar, :CalendarEvent, :PersonalTask ;
    :routedThrough nc:connector ;
    :ingestSource "nextcloud-calendars" .

nc:location_contacts a :NextcloudDataLocation ;
    rdfs:label "Address books" ;
    :locationTemplate "{NEXTCLOUD_URL}/remote.php/dav/addressbooks/users/{user}/" ;
    :accessProtocol "CardDAV" ;
    :holdsClass :AddressBook, :ContactCard ;
    :routedThrough nc:connector ;
    :ingestSource "nextcloud-address-books" .

nc:location_talk a :NextcloudDataLocation ;
    rdfs:label "Talk conversations and chat" ;
    :locationTemplate "{NEXTCLOUD_URL}/ocs/v2.php/apps/spreed/api/" ;
    :accessProtocol "OCS" ;
    :holdsClass :TalkConversation, :TalkMessage ;
    :routedThrough nc:connector ;
    :ingestSource "nextcloud-talk-conversations" .

nc:location_deck a :NextcloudDataLocation ;
    rdfs:label "Deck boards" ;
    :locationTemplate "{NEXTCLOUD_URL}/index.php/apps/deck/api/v1.0/boards" ;
    :accessProtocol "REST" ;
    :holdsClass :DeckBoard, :DeckStack, :DeckCard ;
    :routedThrough nc:connector ;
    :ingestSource "nextcloud-deck-boards" .

nc:location_notes a :NextcloudDataLocation ;
    rdfs:label "Notes (files in the Notes folder)" ;
    :locationTemplate "{NEXTCLOUD_URL}/index.php/apps/notes/api/v1/notes" ;
    :accessProtocol "REST" ;
    :holdsClass :NextcloudNote ;
    :routedThrough nc:connector ;
    :ingestSource "nextcloud-notes" .

nc:location_activity a :NextcloudDataLocation ;
    rdfs:label "Activity stream and notifications" ;
    :locationTemplate "{NEXTCLOUD_URL}/ocs/v2.php/apps/activity/api/v2/activity" ;
    :accessProtocol "OCS" ;
    :holdsClass :ActivityEvent, :NextcloudNotification ;
    :routedThrough nc:connector .

nc:location_accounts a :NextcloudDataLocation ;
    rdfs:label "Accounts, groups and apps" ;
    :locationTemplate "{NEXTCLOUD_URL}/ocs/v2.php/cloud/" ;
    :accessProtocol "OCS" ;
    :holdsClass :IdentityUser, :IdentityGroup, :NextcloudApp ;
    :routedThrough nc:connector .
