nc:tool_get_contact a cp:Tool ;
    rdfs:label "nextcloud_get_contact" ;
    cp:componentId "nextcloud_get_contact" ;
    cp:operatesOn :ContactCard ;
    cp:produces :ContactCard ;
    cp:providesCapability nc:capability_collaboration .

nc:tool_create_contact a cp:Tool ;
    rdfs:label "nextcloud_create_contact" ;
    cp:componentId "nextcloud_create_contact" ;
    cp:operatesOn :AddressBook ;
