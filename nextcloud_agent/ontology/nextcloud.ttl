    cp:componentId "nextcloud_list_address_books" ;
    cp:operatesOn :AddressBook ;
    cp:produces :AddressBook ;
    cp:providesCapability nc:capability_collaboration .

nc:tool_list_contacts a cp:Tool ;
    rdfs:label "nextcloud_list_contacts" ;
    cp:componentId "nextcloud_list_contacts" ;
    cp:operatesOn :AddressBook ;
    cp:produces :ContactCard ;
