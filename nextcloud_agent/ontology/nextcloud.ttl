    cp:providesCapability nc:capability_collaboration .

nc:tool_get_user_quota a cp:Tool ;
    rdfs:label "nextcloud_get_user_quota" ;
    cp:componentId "nextcloud_get_user_quota" ;
    cp:operatesOn :IdentityUser ;
    cp:providesCapability nc:capability_collaboration .

nc:tool_list_versions a cp:Tool ;
    rdfs:label "nextcloud_list_versions" ;
    cp:componentId "nextcloud_list_versions" ;
    cp:operatesOn :File ;
    cp:produces :FileVersion ;
    cp:providesCapability nc:capability_collaboration .

nc:tool_restore_version a cp:Tool ;
    rdfs:label "nextcloud_restore_version" ;
    cp:componentId "nextcloud_restore_version" ;
    cp:operatesOn :FileVersion ;
    cp:providesCapability nc:capability_collaboration .

nc:tool_search_files a cp:Tool ;
    rdfs:label "nextcloud_search_files" ;
    cp:componentId "nextcloud_search_files" ;
    cp:operatesOn :Folder ;
    cp:produces :File ;
    cp:providesCapability nc:capability_collaboration .

nc:tool_list_trash a cp:Tool ;
    rdfs:label "nextcloud_list_trash" ;
    cp:componentId "nextcloud_list_trash" ;
    cp:operatesOn :TrashItem ;
    cp:produces :TrashItem ;
    cp:providesCapability nc:capability_collaboration .

nc:tool_restore_trash_item a cp:Tool ;
    rdfs:label "nextcloud_restore_trash_item" ;
