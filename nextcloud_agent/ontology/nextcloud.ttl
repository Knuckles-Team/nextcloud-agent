    rdfs:label "nextcloud_update_task" ;
    cp:componentId "nextcloud_update_task" ;
    cp:operatesOn :PersonalTask ;
    cp:produces :PersonalTask ;
    cp:providesCapability nc:capability_collaboration .

nc:tool_list_address_books a cp:Tool ;
