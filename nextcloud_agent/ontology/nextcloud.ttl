@prefix : <http://knuckles.team/kg#> .
@prefix nc: <http://knuckles.team/kg/nextcloud#> .
@prefix cp: <http://knuckles.team/kg/connector-pack#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Nextcloud ontology: the domain classes, the connector surface (features, tools,
# skills, prompts), the tool-use contracts and the data locations of the
# nextcloud-mcp connector. Classes and properties live in the shared `:` (kg#)
# namespace; individuals of this pack live in `nc:`. Every pack class rolls up to
# a medulla core class by rdfs:subClassOf; core classes (:File, :Folder,
# :CalendarEvent, :PersonalTask, :IdentityUser, :IdentityGroup, :FileShare) are
# referenced, never redeclared, and the pack imports no engine ontology.

<http://knuckles.team/kg/nextcloud> a owl:Ontology ;
    rdfs:label "Nextcloud Ontology" ;
    rdfs:comment """Nextcloud collaboration model: files, versions, shares, calendars,
    events, tasks, contacts, Talk, Deck, notes, office documents, activity and
    administration; the connector's tools, skills and prompts; the ordered tool-use
    contracts of its business workflows; and where each record lives.""" .

# --- domain classes (each rolls up to medulla core) ---

:Share a owl:Class ;
    rdfs:label "Nextcloud Share" ;
    rdfs:comment "A sharing grant on a file or folder: user, group, Talk, email or public link." ;
    rdfs:subClassOf :FileShare .

:FileVersion a owl:Class ;
    rdfs:label "File Version" ;
    rdfs:comment "A stored earlier content of a Nextcloud file, restorable." ;
    rdfs:subClassOf :File .

:TrashItem a owl:Class ;
    rdfs:label "Trash Item" ;
    rdfs:comment "A deleted file or folder held in the trash bin, restorable." ;
    rdfs:subClassOf :File .

:OfficeDocument a owl:Class ;
    rdfs:label "Office Document" ;
    rdfs:comment "A document, spreadsheet, presentation, diagram or markdown file edited collaboratively." ;
    rdfs:subClassOf :Document .

:NextcloudCalendar a owl:Class ;
    rdfs:label "Nextcloud Calendar" ;
    rdfs:comment "A CalDAV calendar holding events and, when task-capable, tasks." ;
    rdfs:subClassOf :Collection .

:AddressBook a owl:Class ;
    rdfs:label "Address Book" ;
    rdfs:comment "A CardDAV address book of contact cards." ;
    rdfs:subClassOf :Collection .

:ContactCard a owl:Class ;
    rdfs:label "Contact Card" ;
    rdfs:comment "One vCard: a person's or organization's name, emails, phones and organization." ;
    rdfs:subClassOf :Document .

:TalkConversation a owl:Class ;
    rdfs:label "Talk Conversation" ;
    rdfs:comment "A Nextcloud Talk conversation: private group, public or one-to-one." ;
    rdfs:subClassOf :MessageChannel .

:TalkMessage a owl:Class ;
    rdfs:label "Talk Message" ;
    rdfs:comment "One chat message in a Talk conversation." ;
    rdfs:subClassOf :ChatMessage .

:DeckBoard a owl:Class ;
    rdfs:label "Deck Board" ;
    rdfs:comment "A Deck kanban board." ;
    rdfs:subClassOf :Collection .

:DeckStack a owl:Class ;
    rdfs:label "Deck Stack" ;
    rdfs:comment "One column of a Deck board." ;
    rdfs:subClassOf :Collection .

:DeckCard a owl:Class ;
    rdfs:label "Deck Card" ;
    rdfs:comment "One card of work on a Deck board." ;
    rdfs:subClassOf :Task .

:NextcloudNote a owl:Class ;
    rdfs:label "Nextcloud Note" ;
    rdfs:comment "A markdown note of the Notes app." ;
    rdfs:subClassOf :Document .

:ActivityEvent a owl:Class ;
    rdfs:label "Activity Event" ;
    rdfs:comment "One entry of the activity stream: who changed what and when." ;
    rdfs:subClassOf :Event .

:NextcloudNotification a owl:Class ;
    rdfs:label "Nextcloud Notification" ;
    rdfs:comment "One notification addressed to the account." ;
    rdfs:subClassOf :Event .

:NextcloudApp a owl:Class ;
    rdfs:label "Nextcloud App" ;
    rdfs:comment "An installed Nextcloud app (Talk, Deck, Office and others)." ;
    rdfs:subClassOf :Application .

:NextcloudDataLocation a owl:Class ;
    rdfs:label "Nextcloud Data Location" ;
    rdfs:comment "Where one family of Nextcloud records lives and the protocol that reaches it." ;
    rdfs:subClassOf :StorageContainer .

:ToolUseContract a owl:Class ;
    rdfs:label "Tool-use Contract" ;
    rdfs:comment "An ordered business workflow over the connector's tools: its steps, their tools and parameters." ;
    rdfs:subClassOf :Task .

# --- links and fields ---

:inFolder a owl:ObjectProperty ;
    rdfs:label "in folder" ;
    rdfs:comment "Links a File or subfolder to the Folder that contains it." ;
    rdfs:range :Folder .

:sharedWith a owl:ObjectProperty ;
    rdfs:label "shared with" ;
    rdfs:comment "Links a Share to the person, group, conversation or public-link recipient it grants access to." ;
    rdfs:domain :Share .

:sharesResource a owl:ObjectProperty ;
    rdfs:label "shares resource" ;
    rdfs:comment "Links a Share to the File or Folder it exposes." ;
    rdfs:domain :Share .

:hasBlob a owl:ObjectProperty ;
    rdfs:label "has blob" ;
    rdfs:comment "Links a File to the federated :AssetOccurrence holding its raw content-addressed bytes." ;
    rdfs:domain :File ;
    rdfs:range :AssetOccurrence .

:hasDocument a owl:ObjectProperty ;
    rdfs:label "has document" ;
    rdfs:comment "Links a File to the federated :Document carrying its extracted, searchable text." ;
    rdfs:domain :File ;
    rdfs:range :Document .

:versionOf a owl:ObjectProperty ;
    rdfs:label "version of" ;
    rdfs:comment "Links a FileVersion to the File it is an earlier content of." ;
    rdfs:domain :FileVersion ;
    rdfs:range :File .

:inCalendar a owl:ObjectProperty ;
    rdfs:label "in calendar" ;
    rdfs:comment "Links a calendar event or task to the calendar that holds it." ;
    rdfs:range :NextcloudCalendar .

:onBoard a owl:ObjectProperty ;
    rdfs:label "on board" ;
    rdfs:comment "Links a Deck stack or card to its board." ;
    rdfs:range :DeckBoard .

:inConversation a owl:ObjectProperty ;
    rdfs:label "in conversation" ;
    rdfs:comment "Links a Talk message to its conversation." ;
    rdfs:domain :TalkMessage ;
    rdfs:range :TalkConversation .

:path a owl:DatatypeProperty ;
    rdfs:label "path" ;
    rdfs:comment "Server-relative WebDAV path of a File or Folder (for example Team/launch/poster.png)." ;
    rdfs:range xsd:string .

:mimeType a owl:DatatypeProperty ;
    rdfs:label "mime type" ;
    rdfs:comment "MIME content type of a File." ;
    rdfs:domain :File ;
    rdfs:range xsd:string .

:sizeBytes a owl:DatatypeProperty ;
    rdfs:label "size bytes" ;
    rdfs:comment "Size of a File in bytes." ;
    rdfs:domain :File ;
    rdfs:range xsd:integer .

:modifiedAt a owl:DatatypeProperty ;
    rdfs:label "modified at" ;
    rdfs:comment "Last-modified timestamp of a File or Folder." ;
    rdfs:range xsd:string .

# --- data location, routing and federation ---

:locationTemplate a owl:DatatypeProperty ;
    rdfs:label "location template" ;
    rdfs:comment "URL template of a data location; {NEXTCLOUD_URL} is the connector setting and {user} the connected account." ;
    rdfs:domain :NextcloudDataLocation ;
    rdfs:range xsd:string .

:accessProtocol a owl:DatatypeProperty ;
    rdfs:label "access protocol" ;
    rdfs:comment "The protocol that reaches a data location: WebDAV, CalDAV, CardDAV, OCS or REST." ;
    rdfs:domain :NextcloudDataLocation ;
    rdfs:range xsd:string .

:holdsClass a owl:ObjectProperty ;
    rdfs:label "holds class" ;
    rdfs:comment "Links a data location to a domain class whose records it stores." ;
    rdfs:domain :NextcloudDataLocation ;
    rdfs:range owl:Class .

:routedThrough a owl:ObjectProperty ;
    rdfs:label "routed through" ;
    rdfs:comment "Links a data location to the connector that is the only route agents use to reach it." ;
    rdfs:domain :NextcloudDataLocation ;
    rdfs:range cp:Connector .

:ingestSource a owl:DatatypeProperty ;
    rdfs:label "ingest source" ;
    rdfs:comment "The declared connector source id (connector://resources) that federates a location's records into the graph." ;
    rdfs:domain :NextcloudDataLocation ;
    rdfs:range xsd:string .

# --- tool-use contracts and surface links ---

:stepIndex a owl:DatatypeProperty ;
    rdfs:label "step index" ;
    rdfs:comment "The 1-based position of a step in its tool-use contract; order is also stated by :precedes." ;
    rdfs:domain :TaskStep ;
    rdfs:range xsd:integer .

:stepParameters a owl:DatatypeProperty ;
    rdfs:label "step parameters" ;
    rdfs:comment "The tool arguments a step passes, as name=value pairs with <placeholders> for inputs." ;
    rdfs:domain :TaskStep ;
    rdfs:range xsd:string .

:stepGuidance a owl:DatatypeProperty ;
    rdfs:label "step guidance" ;
    rdfs:comment "Why the step runs and how to read its result." ;
    rdfs:domain :TaskStep ;
    rdfs:range xsd:string .

:promptUsesSkill a owl:ObjectProperty ;
    rdfs:label "prompt uses skill" ;
    rdfs:comment "Links an agent-defining prompt to a skill the agent it defines follows." ;
    rdfs:domain cp:Prompt ;
    rdfs:range cp:Skill .

:skillFollowsContract a owl:ObjectProperty ;
    rdfs:label "skill follows contract" ;
    rdfs:comment "Links a skill to the tool-use contract it documents." ;
    rdfs:domain cp:Skill ;
    rdfs:range :ToolUseContract .

# --- the connector and its features ---

nc:connector a cp:Connector ;
    rdfs:label "nextcloud-mcp" ;
    cp:componentId "nextcloud-mcp" ;
    :usesTool :ToolNextcloudAgent ;

    cp:providesFeature nc:feature_files, nc:feature_sharing, nc:feature_calendar, nc:feature_tasks, nc:feature_contacts, nc:feature_talk, nc:feature_deck, nc:feature_notes, nc:feature_office, nc:feature_activity, nc:feature_admin, nc:feature_asset_publishing .

nc:capability_collaboration a :CollaborationCapability ;
    rdfs:label "Nextcloud collaboration" .

nc:feature_files a cp:Feature ;
    rdfs:label "Files: browse, upload, download, move, copy, delete, versions, search, trash" ;
    cp:realizedBy nc:tool_list_files,
        nc:tool_read_file,
        nc:tool_write_file,
        nc:tool_create_folder,
        nc:tool_delete_item,
        nc:tool_move_item,
        nc:tool_copy_item,
        nc:tool_get_properties,
        nc:tool_get_user_quota,
        nc:tool_list_versions,
        nc:tool_restore_version,
        nc:tool_search_files,
        nc:tool_list_trash,
        nc:tool_restore_trash_item,
        nc:skill_nextcloud_files .

nc:feature_sharing a cp:Feature ;
    rdfs:label "Sharing: internal user/group/Talk shares and public links" ;
    cp:realizedBy nc:tool_list_shares,
        nc:tool_get_share,
        nc:tool_create_share,
        nc:tool_update_share,
        nc:tool_delete_share,
        nc:skill_nextcloud_shares .

nc:feature_calendar a cp:Feature ;
    rdfs:label "Calendar: calendars and events with draft invitations (CalDAV)" ;
    cp:realizedBy nc:tool_list_calendars,
        nc:tool_create_calendar,
        nc:tool_delete_calendar,
        nc:tool_list_events,
        nc:tool_get_calendar_object,
        nc:tool_create_event,
        nc:tool_update_event,
        nc:tool_delete_calendar_object,
        nc:skill_nextcloud_calendar .

nc:feature_tasks a cp:Feature ;
    rdfs:label "Tasks: to-dos (VTODO) in task-capable calendars" ;
    cp:realizedBy nc:tool_list_tasks,
        nc:tool_create_task,
        nc:tool_update_task,
        nc:skill_nextcloud_tasks .

nc:feature_contacts a cp:Feature ;
    rdfs:label "Contacts: address books and vCards (CardDAV)" ;
    cp:realizedBy nc:tool_list_address_books,
        nc:tool_list_contacts,
        nc:tool_get_contact,
        nc:tool_create_contact,
        nc:tool_update_contact,
        nc:tool_delete_contact,
        nc:skill_nextcloud_contacts .

nc:feature_talk a cp:Feature ;
    rdfs:label "Talk: conversations, participants and chat" ;
    cp:realizedBy nc:tool_list_conversations,
        nc:tool_get_conversation,
        nc:tool_create_conversation,
        nc:tool_rename_conversation,
        nc:tool_delete_conversation,
        nc:tool_list_participants,
        nc:tool_add_participant,
        nc:tool_remove_participant,
        nc:tool_list_messages,
        nc:tool_send_message,
        nc:tool_delete_message,
        nc:skill_nextcloud_talk .

nc:feature_deck a cp:Feature ;
    rdfs:label "Deck: kanban boards, stacks and cards" ;
    cp:realizedBy nc:tool_list_boards,
        nc:tool_get_board,
        nc:tool_create_board,
        nc:tool_delete_board,
        nc:tool_list_stacks,
        nc:tool_create_stack,
        nc:tool_delete_stack,
        nc:tool_create_card,
        nc:tool_get_card,
        nc:tool_update_card,
        nc:tool_move_card,
        nc:tool_assign_card_user,
        nc:tool_delete_card,
        nc:skill_nextcloud_deck .

nc:feature_notes a cp:Feature ;
    rdfs:label "Notes: markdown notes" ;
    cp:realizedBy nc:tool_list_notes,
        nc:tool_get_note,
        nc:tool_create_note,
        nc:tool_update_note,
        nc:tool_delete_note,
        nc:skill_nextcloud_notes .

nc:feature_office a cp:Feature ;
    rdfs:label "Office: create and collaboratively edit documents, spreadsheets, presentations and markdown" ;
    cp:realizedBy nc:tool_list_document_templates,
        nc:tool_create_document,
        nc:tool_open_document,
        nc:skill_nextcloud_office .

nc:feature_activity a cp:Feature ;
    rdfs:label "Activity and notifications" ;
    cp:realizedBy nc:tool_list_activities,
        nc:tool_list_notifications,
        nc:tool_dismiss_notification,
        nc:skill_nextcloud_activity .

nc:feature_admin a cp:Feature ;
    rdfs:label "Administration: accounts, groups and apps" ;
    cp:realizedBy nc:tool_get_user_info,
        nc:tool_list_users,
        nc:tool_get_user,
        nc:tool_create_user,
        nc:tool_update_user,
        nc:tool_disable_user,
        nc:tool_enable_user,
        nc:tool_delete_user,
        nc:tool_list_groups,
        nc:tool_create_group,
        nc:tool_delete_group,
        nc:tool_list_group_members,
        nc:tool_add_user_to_group,
        nc:tool_remove_user_from_group,
        nc:tool_list_apps,
        nc:tool_get_app,
        nc:tool_enable_app,
        nc:tool_disable_app,
        nc:skill_nextcloud_admin .

nc:feature_asset_publishing a cp:Feature ;
    rdfs:label "Asset publishing: store produced assets in the team folder and share them" ;
    cp:realizedBy nc:skill_nextcloud_publish_asset, nc:prompt_nextcloud_asset_publisher .

# --- tools: one per operation ---

nc:tool_list_files a cp:Tool ;
    rdfs:label "nextcloud_list_files" ;
    cp:componentId "nextcloud_list_files" ;
    cp:operatesOn :Folder ;
    cp:produces :File ;
    cp:providesCapability nc:capability_collaboration .

nc:tool_read_file a cp:Tool ;
    rdfs:label "nextcloud_read_file" ;
    cp:componentId "nextcloud_read_file" ;
    cp:operatesOn :File ;
    cp:providesCapability nc:capability_collaboration .

nc:tool_write_file a cp:Tool ;
    rdfs:label "nextcloud_write_file" ;
    cp:componentId "nextcloud_write_file" ;
    cp:operatesOn :File ;
    cp:produces :File ;
    cp:providesCapability nc:capability_collaboration .

nc:tool_create_folder a cp:Tool ;
