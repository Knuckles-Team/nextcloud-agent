    rdfs:label "nextcloud_update_contact" ;
    cp:componentId "nextcloud_update_contact" ;
    cp:operatesOn :ContactCard ;
    cp:produces :ContactCard ;
    cp:providesCapability nc:capability_collaboration .

nc:tool_delete_contact a cp:Tool ;
    rdfs:label "nextcloud_delete_contact" ;
    cp:componentId "nextcloud_delete_contact" ;
    cp:operatesOn :ContactCard ;
    cp:providesCapability nc:capability_collaboration .

nc:tool_list_conversations a cp:Tool ;
    rdfs:label "nextcloud_list_conversations" ;
    cp:componentId "nextcloud_list_conversations" ;
