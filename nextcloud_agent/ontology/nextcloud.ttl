nc:tool_create_calendar a cp:Tool ;
    rdfs:label "nextcloud_create_calendar" ;
    cp:componentId "nextcloud_create_calendar" ;
    cp:operatesOn :NextcloudCalendar ;
    cp:produces :NextcloudCalendar ;
    cp:providesCapability nc:capability_collaboration .

