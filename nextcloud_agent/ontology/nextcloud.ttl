# --- skills ---

nc:skill_nextcloud_activity a cp:Skill ;
    rdfs:label "nextcloud-activity" ;
    cp:componentId "nextcloud-activity" ;
    cp:appliesTo :ActivityEvent ;
    :usesTool nc:tool_dismiss_notification, nc:tool_list_activities, nc:tool_list_notifications .

nc:skill_nextcloud_admin a cp:Skill ;
    rdfs:label "nextcloud-admin" ;
    cp:componentId "nextcloud-admin" ;
    cp:appliesTo :IdentityUser ;
    :usesTool nc:tool_add_participant, nc:tool_add_user_to_group, nc:tool_create_group, nc:tool_create_user, nc:tool_delete_group, nc:tool_delete_user, nc:tool_disable_app, nc:tool_disable_user, nc:tool_enable_app, nc:tool_enable_user, nc:tool_get_app, nc:tool_get_user, nc:tool_get_user_info, nc:tool_list_apps, nc:tool_list_group_members, nc:tool_list_groups, nc:tool_list_users, nc:tool_remove_user_from_group, nc:tool_update_user ;
    :skillFollowsContract nc:contract_onboard_member .

nc:skill_nextcloud_calendar a cp:Skill ;
    rdfs:label "nextcloud-calendar" ;
    cp:componentId "nextcloud-calendar" ;
    cp:appliesTo :CalendarEvent ;
    :usesTool nc:tool_create_calendar, nc:tool_create_event, nc:tool_delete_calendar, nc:tool_delete_calendar_object, nc:tool_get_calendar_object, nc:tool_list_calendars, nc:tool_list_events, nc:tool_update_event ;
    :skillFollowsContract nc:contract_schedule_meeting .

